# OneDrive Configuration (Microsoft Graph API)
# To use real OneDrive, register an app at https://portal.azure.com
# Go to Azure Active Directory > App registrations > New registration
# Set redirect URI to: http://localhost:8501
# Copy the Application (client) ID below
ONEDRIVE_CLIENT_ID=your_client_id_here

# Mock Settings (set to false to use real OneDrive)
USE_MOCK_ONEDRIVE=true

# AI Model Configuration
TINYLLAMA_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
MODEL_CACHE_DIR=./model_cache
MAX_NEW_TOKENS=512
TEMPERATURE=0.7

# Debug Mode
DEBUG=false
